# Application
HOST=127.0.0.1
PORT=8000
RELOAD=false

# FAQ
FAQ_PATH=data/faqs.json

# Translation
TRANSLATION_PROVIDER=local
TRANSLATION_FALLBACK_ENABLED=true

# Azure Translator
# Required only when Azure translation is used or local fallback is enabled
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# AI Gateway
# Required only when the application actually creates the
# speech transcription / synthesis providers at runtime.
AI_GATEWAY_API_KEY=
